

<Window x:Class="PptRunner.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Icon="Assets/ppt_runner_desktop_icon_full_width.ico"
        Title="PPT Runner"
        Width="1000"
        Height="680"
        MinWidth="820"
        MinHeight="560"
        WindowStartupLocation="CenterScreen"
        Background="#F6F6F7"
        FontFamily="Segoe UI Variable">

    <Window.Resources>

        <!-- Colors -->
        <SolidColorBrush x:Key="PageBackground" Color="#F6F6F7"/>
        <SolidColorBrush x:Key="Surface" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="Border" Color="#E1E1E4"/>

        <SolidColorBrush x:Key="PrimaryText" Color="#1D1D1F"/>
        <SolidColorBrush x:Key="SecondaryText" Color="#6E6E73"/>
        <SolidColorBrush x:Key="MutedText" Color="#8E8E93"/>

        <SolidColorBrush x:Key="Accent" Color="#087F8C"/>
        <SolidColorBrush x:Key="AccentSoft" Color="#E8F4F5"/>

        <SolidColorBrush x:Key="CommandBackground" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="CommandHover" Color="#F1F4F5"/>

        <!-- Command card -->
        <Style x:Key="CommandCard"
               TargetType="Border">

            <Setter Property="Background"
                    Value="{StaticResource CommandBackground}"/>

            <Setter Property="BorderBrush"
                    Value="{StaticResource Border}"/>

            <Setter Property="BorderThickness"
                    Value="1"/>

            <Setter Property="CornerRadius"
                    Value="10"/>

        </Style>

    </Window.Resources>

    <Grid Background="{StaticResource PageBackground}">

        <Grid.RowDefinitions>
            <RowDefinition Height="64"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="48"/>
        </Grid.RowDefinitions>


        <!-- ===================================================== -->
        <!-- HEADER -->
        <!-- ===================================================== -->

        <Border Grid.Row="0"
                Background="{StaticResource Surface}"
                BorderBrush="{StaticResource Border}"
                BorderThickness="0,0,0,1">

            <Grid Margin="28,0">

                <TextBlock Text="PPT Runner"
                           VerticalAlignment="Center"
                           FontSize="18"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource PrimaryText}"/>

                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center">

                    <Ellipse x:Name="StatusDot"
                             Width="8"
                             Height="8"
                             Fill="{StaticResource Accent}"
                             Margin="0,0,8,0"/>

                    <TextBlock x:Name="StatusText"
                               Text="Ready to connect"
                               FontSize="13"
                               Foreground="{StaticResource SecondaryText}"/>

                </StackPanel>

            </Grid>

        </Border>


        <!-- ===================================================== -->
        <!-- MAIN -->
        <!-- ===================================================== -->

        <Grid Grid.Row="1"
              Margin="40,28">

            <!-- ================================================= -->
            <!-- WAITING / CONNECT SCREEN -->
            <!-- ================================================= -->

            <Grid x:Name="ConnectView">

                <StackPanel VerticalAlignment="Center"
                            HorizontalAlignment="Center">

                    <TextBlock Text="Connect your phone"
                               FontSize="28"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource PrimaryText}"
                               HorizontalAlignment="Center"/>

                    <TextBlock Text="Open PPT Runner on your phone and scan the QR code."
                               FontSize="14"
                               Foreground="{StaticResource SecondaryText}"
                               Margin="0,8,0,26"
                               HorizontalAlignment="Center"/>


                    <!-- QR -->
                    <Border Width="300"
                            Height="300"
                            Padding="18"
                            Background="{StaticResource Surface}"
                            BorderBrush="{StaticResource Border}"
                            BorderThickness="1"
                            CornerRadius="12"
                            HorizontalAlignment="Center">

                        <Image x:Name="QrImage"
                               Stretch="Uniform"
                               SnapsToDevicePixels="True"
                               UseLayoutRounding="True"/>

                    </Border>


                    <!-- SESSION -->
                    <StackPanel Orientation="Horizontal"
                                HorizontalAlignment="Center"
                                Margin="0,18,0,0">

                        <TextBlock Text="Session"
                                   FontSize="13"
                                   Foreground="{StaticResource SecondaryText}"
                                   VerticalAlignment="Center"
                                   Margin="0,0,8,0"/>

                        <TextBlock x:Name="SessionIdText"
                                   Text="--------"
                                   FontFamily="Consolas"
                                   FontSize="15"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource PrimaryText}"
                                   VerticalAlignment="Center"/>

                    </StackPanel>


                    <TextBlock x:Name="QrStatusText"
                               Text="Waiting for phone…"
                               FontSize="13"
                               Foreground="{StaticResource SecondaryText}"
                               HorizontalAlignment="Center"
                               Margin="0,10,0,0"/>

                </StackPanel>

            </Grid>


            <!-- ================================================= -->
            <!-- CONNECTED SCREEN -->
            <!-- ================================================= -->

            <Grid x:Name="ConnectedView"
                  Visibility="Collapsed">

                <StackPanel VerticalAlignment="Center"
                            HorizontalAlignment="Center">

                    <TextBlock Text="Phone connected"
                               FontSize="30"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource PrimaryText}"
                               HorizontalAlignment="Center"/>

                    <TextBlock Text="Your phone is ready to control the presentation."
                               FontSize="14"
                               Foreground="{StaticResource SecondaryText}"
                               HorizontalAlignment="Center"
                               Margin="0,8,0,30"/>


                    <!-- CONNECTION CARD -->
                    <Border Width="420"
                            Padding="22"
                            Background="{StaticResource Surface}"
                            BorderBrush="{StaticResource Border}"
                            BorderThickness="1"
                            CornerRadius="10">

                        <Grid>

                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <StackPanel Orientation="Horizontal">

    <Ellipse Width="8"
             Height="8"
             Fill="{StaticResource Accent}"
             Margin="0,0,10,0"
             VerticalAlignment="Center"/>

    <TextBlock x:Name="TransportStatusText"
               Text="Connected locally"
               FontSize="14"
               FontWeight="SemiBold"
               Foreground="{StaticResource PrimaryText}"/>

</StackPanel>

                            <StackPanel Grid.Row="1"
                                        Orientation="Horizontal"
                                        Margin="18,12,0,0">

                                <TextBlock Text="Session"
                                           FontSize="12"
                                           Foreground="{StaticResource SecondaryText}"
                                           Margin="0,0,8,0"/>

                                <TextBlock x:Name="ConnectedSessionText"
                                           Text="--------"
                                           FontFamily="Consolas"
                                           FontSize="12"
                                           FontWeight="SemiBold"
                                           Foreground="{StaticResource PrimaryText}"/>

                            </StackPanel>

                        </Grid>

                    </Border>


                    <!-- REMOTE CONTROLS -->
                    <TextBlock Text="Remote controls"
                               FontSize="13"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource SecondaryText}"
                               HorizontalAlignment="Center"
                               Margin="0,28,0,12"/>

                    <Grid>

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="190"/>
                            <ColumnDefinition Width="190"/>
                        </Grid.ColumnDefinitions>


                        <!-- NEXT -->
                        <Border Grid.Column="0"
                                Style="{StaticResource CommandCard}"
                                Margin="0,0,5,0"
                                Padding="18">

                            <StackPanel>

                                <TextBlock Text="Volume Up"
                                           FontSize="14"
                                           FontWeight="SemiBold"
                                           Foreground="{StaticResource PrimaryText}"
                                           HorizontalAlignment="Center"/>

                                <TextBlock Text="Next slide"
                                           FontSize="12"
                                           Foreground="{StaticResource SecondaryText}"
                                           HorizontalAlignment="Center"
                                           Margin="0,5,0,0"/>

                            </StackPanel>

                        </Border>


                        <!-- PREVIOUS -->
                        <Border Grid.Column="1"
                                Style="{StaticResource CommandCard}"
                                Margin="5,0,0,0"
                                Padding="18">

                            <StackPanel>

                                <TextBlock Text="Volume Down"
                                           FontSize="14"
                                           FontWeight="SemiBold"
                                           Foreground="{StaticResource PrimaryText}"
                                           HorizontalAlignment="Center"/>

                                <TextBlock Text="Previous slide"
                                           FontSize="12"
                                           Foreground="{StaticResource SecondaryText}"
                                           HorizontalAlignment="Center"
                                           Margin="0,5,0,0"/>

                            </StackPanel>

                        </Border>

                    </Grid>

                </StackPanel>

            </Grid>

        </Grid>


        <!-- ===================================================== -->
        <!-- FOOTER -->
        <!-- ===================================================== -->

        <Grid Grid.Row="2"
              Margin="28,0">

            <TextBlock Text="PPT Runner"
                       FontSize="12"
                       Foreground="{StaticResource MutedText}"
                       VerticalAlignment="Center"
                       HorizontalAlignment="Left"/>

            <TextBlock Text="Local network preferred"
                       FontSize="12"
                       Foreground="{StaticResource MutedText}"
                       VerticalAlignment="Center"
                       HorizontalAlignment="Right"/>

        </Grid>

    </Grid>

</Window>